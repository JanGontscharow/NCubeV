using NCubeV.AST
using NCubeV.SMTInterface
using Satisfiability
@satvariable(x[1:3], Real)
additional = []
cons_trans = map(con -> ast2sat(con, x, additional, Dict()), constraints)
expr = Satisfiability.and(cons_trans...)
!isempty(additional) && (expr = expr ∧ Satisfiability.and(additional...)) 
sat!(expr, solver=Z3(), logic="QF_NRA")


ctx = Context()
solver = Solver(ctx)
y1 = real_const(ctx, "x1")
y2 = real_const(ctx, "x2")
y3 = real_const(ctx, "x3")
variables = [y1, y2, y3]
for con in constraints
   add(solver, ast2smt(con, variables, [], Dict()))
end
check(solver)